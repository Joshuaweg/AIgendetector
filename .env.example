# Environment variables for AI Video Detector

# API Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# API Server
API_HOST=0.0.0.0
API_PORT=5000

# Model Configuration
MODEL_PATH=/app/model/full_classifier_best.pt
DEVICE=cuda  # or 'cpu' for CPU-only inference

# File Upload Settings
MAX_FILE_SIZE_MB=100
UPLOAD_FOLDER=temp_uploads
RESULTS_FOLDER=temp_results

# Next.js Frontend (add to your Next.js .env.local)
NEXT_PUBLIC_VIDEO_DETECTOR_API_URL=http://localhost:5000

# Optional: Authentication
# API_KEY=your-api-key-here
# ENABLE_AUTH=False

# Optional: Rate Limiting
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_HOUR=100

# Optional: Monitoring
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=INFO

# Optional: Redis (for caching)
# REDIS_URL=redis://localhost:6379/0
# ENABLE_CACHE=False
